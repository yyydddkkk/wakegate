{
  "name": "wakegate",
  "version": "0.1.0",
  "description": "A framework-agnostic gate that decides whether an event should wake your AI agent.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "wakegate": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
