    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "wakegate": "node src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
